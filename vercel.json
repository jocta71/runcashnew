{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "installCommand": "cd .. && npm install && cd frontend && npm install"
      }
    }
  ],
  "routes": [
    { 
      "src": "/api/(.*)", 
      "dest": "/backend/api/$1" 
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/$1"
    }
  ]
} 